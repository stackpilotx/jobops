# Copy to .env and fill in the values you want.
# Keys set here become defaults; they can still be overridden at request time in the UI.

# --- AI providers (pick any you want) ---
OPENAI_API_KEY=
GROK_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Preferred default provider: openai | grok | groq | claude
DEFAULT_AI_PROVIDER=openai

# Default models
OPENAI_MODEL=gpt-4o-mini
GROK_MODEL=grok-2-latest
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- HTTP scraping ---
REQUEST_TIMEOUT_S=20
USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 14_5) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0 Safari/537.36

# --- Server ---
HOST=127.0.0.1
PORT=8000
